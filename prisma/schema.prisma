// Submission: mỗi dòng là một hồ sơ đã gửi. `data` lưu nguyên trạng thái form
// dạng JSON để tái tạo đúng bản đã gửi kể cả khi cấu trúc tiêu chí đổi về sau;
// `evidenceImages` chỉ lưu metadata ảnh trên Cloudflare R2.
// AppConfig: các link mẫu đơn và thời gian nhận hồ sơ, sửa được qua mục Quản
// trị. Mật khẩu quản trị nằm ở biến môi trường ADMIN_PASSWORD, không ở database.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Submission {
  id             String   @id @default(cuid())
  fullName       String
  mssv           String
  className      String
  data           Json
  evidenceImages Json
  status         String   @default("Chưa kiểm tra")
  note           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  review         SubmissionReview?
  reviewRevisions SubmissionReviewRevision[]

  @@unique([mssv])
}

// Bản kiểm tra của Ban hoàn toàn tách khỏi payload gốc do sinh viên gửi.
model SubmissionReview {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status       String     @default("Chưa kiểm tra")
  note         String     @default("")
  flags        Json       @default("{}")
  reviewer     String
  submissionUpdatedAt DateTime
  checkedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  revisions    SubmissionReviewRevision[]
}

model SubmissionReviewRevision {
  id        String           @id @default(cuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewId     String?
  review       SubmissionReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  status    String
  note      String
  flags     Json
  reviewer  String
  submissionUpdatedAt DateTime
  createdAt DateTime         @default(now())

  @@index([submissionId, createdAt])
  @@index([reviewId])
}

model AdminSession {
  tokenHash String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model StorageCleanupJob {
  path          String   @id
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String   @default("")
  lockedAt      DateTime?
  lockedBy      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt])
}

// Danh sách đóng các thành viên được phép đứng tên trên bản kiểm tra.
// Giao diện chỉ chọn từ bảng này để tránh viết tắt/viết hoa không đồng nhất.
model AdminReviewer {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, name])
}

model AppConfig {
  key                  String   @id // luôn chỉ 1 dòng, key = "main"
  linkDeXuatHoatDong   String?
  linkXacNhanClb       String?
  linkXacNhanNgoaiKhoa String?
  linkXacNhanChung     String?
  submissionsOpen      Boolean  @default(true)
  submissionStartAt    DateTime?
  submissionEndAt      DateTime?
  submissionClosedMessage String @default("Hiện không trong thời gian nhận hồ sơ.")
  activityCatalog        Json?
  reportYear             Int      @default(2025)
  updatedAt            DateTime @updatedAt
}
